FROM node:20-alpine

WORKDIR /app

ARG VITE_OIDC_AUTHORITY=http://localhost:8080/realms/bo
ARG VITE_OIDC_CLIENT_ID=bo-web
ENV VITE_OIDC_AUTHORITY=$VITE_OIDC_AUTHORITY
ENV VITE_OIDC_CLIENT_ID=$VITE_OIDC_CLIENT_ID

COPY package*.json ./
RUN npm ci

COPY . ./
RUN npm run build

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=8888

EXPOSE 8888

CMD ["node", "local-server.mjs"]
